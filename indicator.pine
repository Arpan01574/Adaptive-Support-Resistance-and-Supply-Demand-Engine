// Setup type toggles
enableZoneReject    = input.bool(true, "Setup: ZONE_REJECT", group = G_SIG)
enableFlipRetest    = input.bool(true, "Setup: FLIP_RETEST", group = G_SIG)
enableSweepReclaim  = input.bool(true, "Setup: SWEEP_RECLAIM", group = G_SIG, tooltip = "TEST status — liquidity sweep + reclaim at zone/level.")
enableDisplacement  = input.bool(false, "Setup: DISPLACEMENT_RETEST", group = G_SIG, tooltip = "TEST status — retest of displacement origin.")
enableBosRetest     = input.bool(false, "Setup: BOS_RETEST", group = G_SIG, tooltip = "TEST status — retest after break of structure.")

// --- 8 | RISK MODEL & COSTS ---
slBufferATR  = input.float(0.50, "SL Buffer (ATR)", minval = 0.0, step = 0.05, group = G_RISK)
maxRiskATR   = input.float(2.5, "Max Risk (ATR)", minval = 0.3, step = 0.1, group = G_RISK)
tp1R         = input.float(1.5, "TP1 (R)", minval = 0.2, step = 0.1, group = G_RISK)
tp2R         = input.float(3.0, "TP2 (R)", minval = 0.5, step = 0.1, group = G_RISK)
tp1Frac      = input.float(33.0, "Close % At TP1", minval = 10.0, maxval = 100.0, step = 5.0, group = G_RISK)
tp2Frac      = input.float(33.0, "Close % At TP2", minval = 0.0, maxval = 100.0, step = 5.0, group = G_RISK)
trailATR     = input.float(1.5, "Trailing Stop (ATR)", minval = 0.5, step = 0.1, group = G_RISK)
minRoomR     = input.float(2.0, "Min Room To Opposing Zone (R)", minval = 0.0, step = 0.25, group = G_RISK)
timeStopBars = input.int(60, "Time Stop (Bars)", minval = 5, group = G_RISK)
feePct       = input.float(0.04, "Fee Per Side (%)", minval = 0.0, step = 0.01, group = G_RISK, tooltip = "Binance Futures taker default 0.04%.")
slipPct      = input.float(0.02, "Slippage Per Side (%)", minval = 0.0, step = 0.01, group = G_RISK)
maxCostR     = input.float(0.15, "Max Round-Trip Cost (R)", minval = 0.0, step = 0.05, group = G_RISK, tooltip = "v3 tightened from 0.20 to 0.15.")
riskPctEq    = input.float(0.5, "Risk Per Trade (% equity)", minval = 0.01, maxval = 5.0, step = 0.05, group = G_RISK)
sigTtlMult   = input.float(2.0, "Signal TTL (× bar period)", minval = 0.5, step = 0.5, group = G_RISK, tooltip = "Signal expires after this many bar periods.")

// --- 9 | MARKET STRUCTURE ---
structLen    = input.int(5, "Swing Length", minval = 2, maxval = 20, group = G_STRUCT)
bosATRMult   = input.float(0.1, "BOS Confirm (ATR beyond swing)", minval = 0.0, step = 0.05, group = G_STRUCT)
showStructure = input.bool(true, "Show Structure Labels", group = G_STRUCT)


// --- FVG logic ---
bool fvgBull = low > high[2] and close[1] > open[1]
bool fvgBear = high < low[2] and close[1] < open[1]

// --- 10 | LIQUIDITY ENGINE ---
eqTol       = input.float(0.15, "Equal High/Low Tolerance (ATR)", minval = 0.01, step = 0.05, group = G_LIQ)
sweepMinATR = input.float(0.05, "Min Sweep Depth (ATR)", minval = 0.01, step = 0.01, group = G_LIQ)
reclaimBars = input.int(3, "Max Reclaim Bars", minval = 1, maxval = 10, group = G_LIQ)
showSweeps  = input.bool(true, "Show Sweep Labels", group = G_LIQ)

// --- 11 | REGIME ENGINE ---
regimeATRPeriod = input.int(500, "ATR Percentile Window", minval = 50, group = G_REG)
regimeVolHi     = input.float(75.0, "High Vol Percentile", minval = 50.0, maxval = 99.0, group = G_REG)
regimeVolLo     = input.float(25.0, "Low Vol Percentile", minval = 1.0, maxval = 50.0, group = G_REG)
regimeTrendFlat = input.float(0.25, "Trend Flat Band (ATR)", minval = 0.0, step = 0.05, group = G_REG)

// --- 12 | ALERTS / WEBHOOK ---
alertPass    = input.string("CHANGE_ME", "Webhook Passphrase", group = G_ALR, tooltip = "Used in alert() JSON only. NOT placed in alertcondition() messages.")
strategyName = input.string("ASR_v3", "Strategy Name", group = G_ALR)
exchangeName = input.string("BINANCE", "Exchange Tag", group = G_ALR)
sendExit     = input.bool(true, "Send EXIT Alerts", group = G_ALR)
hbEnable     = input.bool(false, "Send HEARTBEAT Alerts", group = G_ALR)
hbBars       = input.int(15, "Heartbeat Every N Bars", minval = 1, group = G_ALR)

// --- 13 | DASHBOARD & VISUALS ---
showDash   = input.bool(true, "Show Dashboard", group = G_UI)
dashPos    = input.string("Top Right", "Dashboard Position", options = ["Top Left", "Top Right", "Middle Right", "Bottom Left", "Bottom Right"], group = G_UI)
showTrades = input.bool(true, "Show Trade Boxes & Labels", group = G_UI)
keepTrades = input.int(15, "Trades To Keep On Chart", minval = 1, maxval = 60, group = G_UI)
showHtfEma = input.bool(true, "Show HTF Trend EMA", group = G_UI)
showVwap   = input.bool(false, "Show Session VWAP", group = G_UI, tooltip = "UTC-day VWAP. TEST feature.")
maxRetired = input.int(15, "Max Retired Zone Boxes", minval = 0, maxval = 50, group = G_UI, tooltip = "BUG-21 fix: cap retained history boxes.")

// ============================================================================================
// BUG-16 FIX: Validate TP ordering at load
// ============================================================================================
var bool _tpValid = tp2R > tp1R
if barstate.isfirst and not _tpValid
    runtime.error("TP2 (" + str.tostring(tp2R) + ") must be greater than TP1 (" + str.tostring(tp1R) + ")")

// ============================================================================================
// BUG-18 FIX: Block HTF below chart timeframe
// ============================================================================================
chartSec   = timeframe.in_seconds()
htfSec     = timeframe.in_seconds(htfRes)
trendSec   = timeframe.in_seconds(trendTF)
if barstate.isfirst and (htfSec < chartSec or trendSec < chartSec)
    runtime.error("HTF / Trend timeframe must be >= chart timeframe")

// ============================================================================================
// ASSET DETECTOR  (BUG-19 style: robust, with user override)
// ============================================================================================
f_isFxPair(string s) =>
    bool ok = false
    if str.length(s) == 6
        array<string> ccy = array.from("USD", "EUR", "GBP", "JPY", "AUD", "CAD", "CHF", "NZD", "INR", "SEK", "NOK", "DKK", "SGD", "HKD", "MXN", "ZAR", "TRY", "PLN", "CNH")
        ok := array.includes(ccy, str.substring(s, 0, 3)) and array.includes(ccy, str.substring(s, 3, 6))
    ok

f_hasPrefix(string s, array<string> prefixes) =>
    bool hit = false
    for p in prefixes
        if str.startswith(s, p)
            hit := true
            break
    hit

f_detectAsset() =>
    string tkr = str.upper(syminfo.ticker)
    string rt  = str.upper(syminfo.root)
    string bc  = na(syminfo.basecurrency) ? "" : str.upper(syminfo.basecurrency)
    string ty  = syminfo.type
    bool nonEq = ty != "stock" and ty != "fund" and ty != "dr" and ty != "right" and ty != "warrant" and ty != "structured"
    array<string> cryptoRoots  = array.from("BTC", "MBT", "ETH", "MET", "SOL", "MSL", "XRP", "MXP", "BNB", "DOGE", "ADA", "LTC", "BCH", "DOT", "AVAX", "LINK", "MATIC", "TRX", "SHIB", "UNI", "ATOM", "XLM", "ETC", "NEAR", "APT", "ARB", "OP", "SUI", "TON", "PEPE", "INJ", "FIL", "AAVE")
    array<string> cryptoPrefix = array.from("BTC", "ETH", "SOL", "XRP", "BNB", "DOGE", "ADA", "LTC", "BCH", "AVAX", "LINK", "MATIC", "TRX", "SHIB", "XLM")
    array<string> macroRoots   = array.from("DXY", "VIX", "US02Y", "US03Y", "US05Y", "US10Y", "US20Y", "US30Y", "TNX", "TYX", "FVX", "IRX")
    array<string> goldRoots    = array.from("GC", "MGC", "QO", "GOLD")
    array<string> silverRoots  = array.from("SI", "SIL", "QI", "HG", "MHG", "QC", "COPPER", "XCU")
    array<string> energyRoots  = array.from("CL", "MCL", "QM", "NG", "MNG", "QG", "BZ", "BB", "MBC", "CY", "RB", "HO")
    array<string> energyPrefix = array.from("XTI", "XBR", "USOIL", "UKOIL", "WTI", "BRENT", "BCO", "CRUDE")
    array<string> indexRoots   = array.from("ES", "MES", "NQ", "MNQ", "YM", "MYM", "RTY", "M2K", "NKD", "MNK", "FDAX", "FDXM", "FDXS", "FESX", "FSXE", "FTUK", "SPX", "SP500", "US500", "NAS100", "NDX", "NDQ", "USTEC", "US100", "DJI", "US30", "DJ30", "DAX", "DE40", "GER40", "GER30", "UK100", "JP225", "NI225", "HK50", "NIFTY", "BANKNIFTY", "SENSEX")
    array<string> cmeFxRoots   = array.from("6E", "6J", "6B", "6S", "6A", "6C", "6N", "M6E", "M6A", "M6B", "MJY", "MSF", "MCD", "SIR", "MIR")
    string res = "OTHER"
    if ty == "crypto" or (nonEq and (array.includes(cryptoRoots, rt) or array.includes(cryptoRoots, bc) or f_hasPrefix(tkr, cryptoPrefix)))
        res := "CRYPTO"
    else if array.includes(macroRoots, rt) or array.includes(macroRoots, tkr)
        res := "MACRO"
    else if array.includes(goldRoots, rt) or f_hasPrefix(tkr, array.from("XAU", "GOLD"))
        res := "GOLD"
    else if array.includes(silverRoots, rt) or f_hasPrefix(tkr, array.from("XAG", "XCU"))
        res := "SILVER"
    else if array.includes(energyRoots, rt) or f_hasPrefix(tkr, energyPrefix)
        res := "ENERGY"
    else if ty == "index" or array.includes(indexRoots, rt) or array.includes(indexRoots, tkr)
        res := "INDEX"
    else if ty == "forex" or array.includes(cmeFxRoots, rt) or f_isFxPair(tkr)
        res := "FOREX"
    res

f_detectMarket() =>
    string ty = syminfo.type
    string tkr = str.upper(syminfo.ticker)
    string res = "OTHER"
    if ty == "crypto"
        res := str.contains(tkr, "PERP") or str.contains(tkr, ".P") or str.endswith(tkr, "USDT") ? "PERPETUAL" : "SPOT"
    else if ty == "forex"
        res := "FOREX"
    else if ty == "futures"
        res := "FUTURES"
    else if ty == "cfd"
        res := "CFD"
    else if ty == "stock" or ty == "fund" or ty == "dr"
        res := "SPOT"
    res

var string assetType  = assetOverride != "Auto" ? assetOverride : f_detectAsset()
var string marketType = marketOverride != "Auto" ? marketOverride : f_detectMarket()
var bool   isSpot     = marketType == "SPOT"

// ============================================================================================
// ASSET AUTO-TUNE PARAMETERS
// ============================================================================================
int   p_decay = 700
float p_mom   = 0.50
int   p_nPiv  = 10
float p_space = 0.40
if assetType == "GOLD"
    p_decay := 600
    p_nPiv  := 8
else if assetType == "SILVER"
    p_decay := 650
    p_mom   := 0.45
    p_nPiv  := 8
else if assetType == "CRYPTO"
    p_decay := 500
    p_nPiv  := 8
    p_space := 0.30
else if assetType == "FOREX"
    p_decay := 900
    p_mom   := 0.40
    p_space := 0.50
else if assetType == "INDEX"
    p_mom   := 0.45
else if assetType == "ENERGY"
    p_decay := 800
    p_mom   := 0.45

int   dyn_decay = useAutoAsset ? p_decay : decayFactor
float dyn_mom   = useAutoAsset ? p_mom : momentumBodyMult
int   dyn_nPiv  = useAutoAsset ? p_nPiv : nPiv
float dyn_space = p_space

// ============================================================================================
// TYPES & PERSISTENT COLLECTIONS
// ============================================================================================
// Zone status constants
var int Z_CREATED     = 0
var int Z_QUALIFYING  = 1
var int Z_ACTIVE      = 2
var int Z_RETESTED    = 3
var int Z_DEGRADED    = 4
var int Z_FLIPPED     = 5
var int Z_INVALIDATED = 6
var int Z_EXPIRED     = 7

// Setup type constants
var int S_ZONE_REJECT   = 1
var int S_FLIP_RETEST   = 2
var int S_SWEEP_RECLAIM = 3
var int S_DISP_RETEST   = 4
var int S_BOS_RETEST    = 5

// Exit reason constants
var int X_STOP_LOSS    = 1
var int X_BE_AFTER_TP1 = 2
var int X_TP2          = 3
var int X_TIME_STOP    = 4
var int X_TRAIL_EXIT   = 5

type zoneObj
    int   id
    float top
    float btm
    bool  isBull
    int   birthBar          // bar_index at confirmation (NOT pivot bar) — BUG-05 fix
    int   birthTime
    int   touches       = 0
    int   qualTouches   = 0   // touches with wick ≥ threshold AND close outside
    int   lastTouchTime = 0
    float maxReaction   = 0.0 // BUG-04 fix: only post-touch excursion
    bool  reactionEarned = false
    int   reactionSpeed = 0   // bars to reach 1 ATR after touch
    float displacement  = 0.0 // creating bar's body / ATR
    int   volQuality    = 0   // 0 = no data, 1 = present, 2 = surge
    int   htfBonus      = 0
    bool  mtfConf       = false
    bool  pdwConf       = false  // near PDH/PDL/PWH/PWL
    int   failedBreaks  = 0     // BUG-07 fix: sweep events tracked
    bool  flipped       = false
    int   flipBar       = 0
    float flipQuality   = 0.0  // BUG-08 fix: displacement + vol of the break
    int   tier          = 0    // 0=none, 1=Strong, 2=Elite
    float qualityScore  = 0.0  // zone quality 0-35
    int   lastSigBar    = 0
    int   sigCount      = 0
    int   status        = 0    // lifecycle state
    int   freshness     = 100  // BUG-06 fix: decays continuously (100 at birth)
    box   visBox
    line  topLn
    line  btmLn
    label lvlLbl

type mtfZone
    box    b
    string txt

type sigCand
    zoneObj z
    float   score      = 0.0
    int     setupType  = 0
    bool    htfC       = false
    bool    mtfC       = false
    float   wickF      = 0.0
    float   zoneScore  = 0.0
    float   setupScore = 0.0
    float   ctxScore   = 0.0

type tradeVis
    box    rb
    box    gb
    line   l1
    label  lb
    int    dir = 0
    string tag = ""

// BUG-09 fix: single zone array (both polarities in one store)
var array<zoneObj>  zones     = array.new<zoneObj>()
var array<mtfZone>  supply_HT = array.new<mtfZone>()
var array<mtfZone>  demand_HT = array.new<mtfZone>()
var array<tradeVis> tVis      = array.new<tradeVis>()
var array<int>      nextZoneIdArr = array.new<int>(1, 0)
var array<int>      retiredCountArr = array.new<int>(1, 0)   // BUG-21 fix: track retired boxes

// ============================================================================================
// SERIES, CANDLE METRICS, VOLUME
// ============================================================================================
confirmed      = barstate.isconfirmed
curTFMS        = chartSec * 1000
insideLookback = bar_index > last_bar_index - maxBarsBack
atr            = ta.atr(atrLen)
atrPct         = close > 0 ? atr / close * 100.0 : 0.0
atrVol         = ta.atr(200)
momentCTD      = time + zoneOffset * curTFMS
extrap         = extendR ? extend.right : extend.none
htfTol         = atr * htfTolATR
tp1F           = tp1Frac / 100.0
tp2F           = tp2Frac / 100.0
tp3F           = math.max(0.0, 1.0 - tp1F - tp2F)
fmtPx          = syminfo.mintick < 0.01 ? "#.########" : format.mintick
baseTxt        = na(syminfo.basecurrency) ? "" : syminfo.basecurrency
quoteTxt       = syminfo.currency
var string tSize = textSize == "Auto" ? size.auto : textSize == "Tiny" ? size.tiny : textSize == "Small" ? size.small : textSize == "Normal" ? size.normal : textSize == "Large" ? size.large : size.huge

candleBody  = math.abs(close - open)
candleRange = high - low
upperWick   = high - math.max(open, close)
lowerWick   = math.min(open, close) - low
isBearWick  = upperWick > candleBody
isBullWick  = lowerWick > candleBody
avgBody20   = ta.sma(candleBody, 20)

// BUG-17 fix: explicit volume handling
hasVolData     = ta.cum(nz(volume)) > 0
avgVol         = ta.sma(nz(volume), volLen)
volShort       = ta.ema(nz(volume), 5)
volLong        = ta.ema(nz(volume), 10)
volOsc         = volLong > 0 ? 100.0 * (volShort - volLong) / volLong : 0.0
// BUG-17 fix: do NOT force surge when volume is absent
hasVolumeSurge = hasVolData and volOsc > volThresh
volState       = not hasVolData ? 0 : hasVolumeSurge ? 2 : 1   // 0=none, 1=present, 2=surge

// Momentum candles among the last pivR bars
int bullMomentum = 0
int bearMomentum = 0
for i = 0 to pivR - 1
    if candleBody[i] >= avgBody20[i] * dyn_mom
        if close[i] > open[i]
            bullMomentum += 1
        else
            bearMomentum += 1

// ============================================================================================
// PIVOTS (BUG-19 fix: detect on true high/low always)
// ============================================================================================
pivot_high = ta.pivothigh(high, pivL, pivR)
pivot_low  = ta.pivotlow(low, pivR, pivR)

bandRaw = math.min(atr * zoneMult, close * (maxPct / 100.0)) / 2.0
hiSince = ta.highest(high, pivR)
loSince = ta.lowest(low, pivR)

// Values at the pivot bar (pivR bars ago)
bandR   = nz(bandRaw[pivR])
volR    = nz(volume[pivR])
avgVolR = nz(avgVol[pivR])
impulseR = math.abs(close[pivR] - open[pivR])
avgBodyR = nz(avgBody20[pivR])
birthR  = bar_index   // BUG-05 fix: birth = confirmation time (now), not pivot bar
timeR   = nz(time[pivR])

// ============================================================================================
// HTF CONTEXT (non-repainting: [1] offset + lookahead_on)
// ============================================================================================
f_htfLevels(int pLen) =>
    float ph = ta.pivothigh(high, pLen, pLen)
    float pl = ta.pivotlow(low, pLen, pLen)
    float h1 = ta.valuewhen(not na(ph), ph, 0)
    float h2 = ta.valuewhen(not na(ph), ph, 1)
    float h3 = ta.valuewhen(not na(ph), ph, 2)
    float l1 = ta.valuewhen(not na(pl), pl, 0)
    float l2 = ta.valuewhen(not na(pl), pl, 1)
    float l3 = ta.valuewhen(not na(pl), pl, 2)
    [h1[1], h2[1], h3[1], l1[1], l2[1], l3[1]]

[hH1, hH2, hH3, hL1, hL2, hL3] = request.security(syminfo.tickerid, htfRes, f_htfLevels(htfPivLen), lookahead = barmerge.lookahead_on)
[tEma, tCls] = request.security(syminfo.tickerid, trendTF, [ta.ema(close, trendLen)[1], close[1]], lookahead = barmerge.lookahead_on)
htfTrend = na(tEma) or na(tCls) ? 0 : tCls > tEma ? 1 : tCls < tEma ? -1 : 0

// Previous day/week levels (non-repainting)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// VWAP (UTC-day reset)
vwapVal = ta.vwap(hlc3)

f_nearLevel(float lvl, float zTop, float zBtm, float tol) =>
    not na(lvl) and lvl >= zBtm - tol and lvl <= zTop + tol

f_htfConf(bool isBullZone, float zTop, float zBtm, float tol) =>
    bool hit = false
    if useMTF
        if isBullZone
            hit := f_nearLevel(hL1, zTop, zBtm, tol) or f_nearLevel(hL2, zTop, zBtm, tol) or f_nearLevel(hL3, zTop, zBtm, tol)
        else
            hit := f_nearLevel(hH1, zTop, zBtm, tol) or f_nearLevel(hH2, zTop, zBtm, tol) or f_nearLevel(hH3, zTop, zBtm, tol)
    hit

f_pdwConf(float zTop, float zBtm, float tol) =>
    f_nearLevel(pdh, zTop, zBtm, tol) or f_nearLevel(pdl, zTop, zBtm, tol) or f_nearLevel(pwh, zTop, zBtm, tol) or f_nearLevel(pwl, zTop, zBtm, tol)

f_mtfOverlap(bool isBullZone, float zTop, float zBtm) =>
    bool hit = false
    array<mtfZone> arr = isBullZone ? demand_HT : supply_HT
    for m in arr
        float bt = box.get_top(m.b)
        float bb = box.get_bottom(m.b)
        if not na(bt) and not na(bb) and zBtm <= bt and zTop >= bb
            hit := true
            break
    hit

// ============================================================================================
// STRUCTURE ENGINE  (BOS / swing state — non-repainting)
// ============================================================================================
var float lastSwingHigh  = na
var float lastSwingLow   = na
var int   lastSwingHighBar = 0
var int   lastSwingLowBar  = 0
var float prevSwingHigh  = na
var float prevSwingLow   = na
var int   structureState = 0   // -1=DOWN, 0=RANGE, 1=UP
var int   lastBosBar     = 0
var int   lastBosDir     = 0   // direction of last BOS

structPivH = ta.pivothigh(high, structLen, structLen)
structPivL = ta.pivotlow(low, structLen, structLen)

if confirmed and not na(structPivH)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := structPivH
    lastSwingHighBar := bar_index - structLen

if confirmed and not na(structPivL)
    prevSwingLow := lastSwingLow
    lastSwingLow := structPivL
    lastSwingLowBar := bar_index - structLen

// BOS detection (on confirmed bars)
var bool bosUp   = false
var bool bosDn   = false
bosUp   := false
bosDn   := false

if confirmed and not na(lastSwingHigh) and not na(atr)
    if close > lastSwingHigh + bosATRMult * atr and structureState != 1
        bosUp := true
        structureState := 1
        lastBosBar := bar_index
        lastBosDir := 1
        if showStructure
            label.new(bar_index, low, "BOS↑", style = label.style_label_up, color = color.new(#00c853, 20), textcolor = color.white, size = size.tiny)

if confirmed and not na(lastSwingLow) and not na(atr)
    if close < lastSwingLow - bosATRMult * atr and structureState != -1
        bosDn := true
        structureState := -1
        lastBosBar := bar_index
        lastBosDir := -1
        if showStructure
            label.new(bar_index, high, "BOS↓", style = label.style_label_down, color = color.new(#ff1744, 20), textcolor = color.white, size = size.tiny)

// HH/HL/LH/LL classification
var string swingLabel = ""
if confirmed and not na(structPivH) and not na(prevSwingHigh)
    swingLabel := structPivH > prevSwingHigh ? "HH" : "LH"
if confirmed and not na(structPivL) and not na(prevSwingLow)
    swingLabel := structPivL > prevSwingLow ? "HL" : "LL"

// ============================================================================================
// LIQUIDITY ENGINE  (sweep detection, equal highs/lows)
// ============================================================================================
var float lastEqHigh    = na
var float lastEqLow     = na
var int   lastEqHighBar = 0
var int   lastEqLowBar  = 0
var bool  sweepUpEvt    = false
var bool  sweepDnEvt    = false
var float sweepUpLow    = na    // the extreme of the sweep (for reclaim)
var float sweepDnHigh   = na
var int   sweepUpBar    = 0
var int   sweepDnBar    = 0
var bool  reclaimUp     = false
var bool  reclaimDn     = false

// Equal highs/lows: two recent swing highs/lows within tolerance
if confirmed and not na(structPivH) and not na(prevSwingHigh) and not na(atr)
    if math.abs(structPivH - prevSwingHigh) <= eqTol * atr
        lastEqHigh := math.max(structPivH, prevSwingHigh)
        lastEqHighBar := bar_index

if confirmed and not na(structPivL) and not na(prevSwingLow) and not na(atr)
    if math.abs(structPivL - prevSwingLow) <= eqTol * atr
        lastEqLow := math.min(structPivL, prevSwingLow)
        lastEqLowBar := bar_index

// Sweep detection: price breaks beyond a level then closes back inside
sweepUpEvt := false
sweepDnEvt := false
reclaimUp  := false
reclaimDn  := false

if confirmed and not na(atr)
    // Check sweep above resistance (sweep into supply then reclaim)
    float resLevel = na
    if not na(lastEqHigh) and (bar_index - lastEqHighBar) > 3
        resLevel := lastEqHigh
    else if not na(lastSwingHigh) and (bar_index - lastSwingHighBar) > 3
        resLevel := lastSwingHigh

    if not na(resLevel)
        if high > resLevel + sweepMinATR * atr and close < resLevel
            sweepUpEvt := true
            sweepDnHigh := high
            sweepDnBar := bar_index
            if showSweeps
                label.new(bar_index, high, "SW↓", style = label.style_label_down, color = color.new(#ff9800, 30), textcolor = color.white, size = size.tiny)

    // Check sweep below support (sweep into demand then reclaim)
    float supLevel = na
    if not na(lastEqLow) and (bar_index - lastEqLowBar) > 3
        supLevel := lastEqLow
    else if not na(lastSwingLow) and (bar_index - lastSwingLowBar) > 3
        supLevel := lastSwingLow

    if not na(supLevel)
        if low < supLevel - sweepMinATR * atr and close > supLevel
            sweepDnEvt := true
            sweepUpLow := low
            sweepUpBar := bar_index
            if showSweeps
                label.new(bar_index, low, "SW↑", style = label.style_label_up, color = color.new(#ff9800, 30), textcolor = color.white, size = size.tiny)

    // Reclaim check for pending sweeps (within reclaimBars)
    if not na(sweepUpLow) and (bar_index - sweepUpBar) <= reclaimBars and (bar_index - sweepUpBar) >= 1
        if close > supLevel
            reclaimUp := true
    if not na(sweepDnHigh) and (bar_index - sweepDnBar) <= reclaimBars and (bar_index - sweepDnBar) >= 1
        if close < resLevel
            reclaimDn := true

// --- CHoCH Logic ---
var bool chochBull = false
var bool chochBear = false
if confirmed
    if sweepDnEvt and close > lastSwingHigh
        chochBull := true
    if sweepUpEvt and close < lastSwingLow
        chochBear := true
    // Reset choch on new structure
    if not na(structPivH)
        chochBull := false
    if not na(structPivL)
        chochBear := false

// ============================================================================================
// REGIME ENGINE  (trend × volatility)
// ============================================================================================
// ATR percentile rank
atrPctNorm = close > 0 ? atr / close * 100.0 : 0.0
atrPercentile = ta.percentrank(atrPctNorm, regimeATRPeriod)

// Volatility regime: 0=normal, 1=high, -1=low
volRegime = atrPercentile >= regimeVolHi ? 1 : atrPercentile <= regimeVolLo ? -1 : 0

// Trend regime uses HTF trend EMA (already computed)
// -1=DOWN, 0=FLAT/RANGE, 1=UP
trendRegime = na(tEma) or na(tCls) or na(atr) ? 0 : math.abs(tCls - tEma) < regimeTrendFlat * atr ? 0 : tCls > tEma ? 1 : -1

// Combined regime string for display
f_regimeStr() =>
    string t = trendRegime == 1 ? "TREND↑" : trendRegime == -1 ? "TREND↓" : "RANGE"
    string v = volRegime == 1 ? " +HiVol" : volRegime == -1 ? " +LoVol" : ""
    t + v

// ============================================================================================
// ZONE HELPERS
// ============================================================================================
f_zoneColor(bool isElite, bool isBull) =>
    isElite ? (isBull ? color.new(#00c853, 78) : color.new(#ff1744, 78)) : (isBull ? color.new(#69f0ae, 88) : color.new(#ff8a80, 88))

// BUG-06 fix: quality score incorporates freshness decay
f_calcQualityScore(zoneObj z, float _atr) =>
    float qs = 0.0
    // Base: displacement quality (0-8)
    qs += math.min(z.displacement / 1.5, 1.0) * 8.0
    // Touch quality (0-6): first 2 touches add value, then degrades — BUG-04/MATH-01 fix
    float touchVal = z.qualTouches >= 1 ? 4.0 : 0.0
    touchVal += z.qualTouches >= 2 ? 2.0 : 0.0
    touchVal -= math.max(0, z.qualTouches - 3) * 1.0   // degradation
    qs += math.max(0.0, touchVal)
    // Reaction quality (0-6): only post-touch excursion — BUG-04 fix
    if z.reactionEarned
        qs += 4.0
        if z.reactionSpeed > 0 and z.reactionSpeed < 10
            qs += 2.0
    // HTF confluence (0-5)
    if z.htfBonus > 0
        qs += 5.0
    // MTF confluence (0-3)
    if z.mtfConf
        qs += 3.0
    // PDW confluence (0-2)
    if z.pdwConf
        qs += 2.0
    // Volume quality (0-3)
    qs += z.volQuality == 2 ? 3.0 : z.volQuality == 1 ? 1.0 : 0.0
    // Freshness decay — BUG-06 fix: actually affects scoring
    float freshnessF = z.freshness / 100.0
    qs *= freshnessF
    // Zone width penalty: very wide zones are less precise
    float zWidth = (z.top - z.btm)
    if _atr > 0 and zWidth / _atr > 1.5
        qs *= 0.85
    // Flip quality bonus (BUG-08 fix: only earned quality)
    if z.flipped and z.flipQuality > 1.0
        qs += math.min(z.flipQuality, 3.0)
    math.min(35.0, math.max(0.0, qs))

f_tier(float qs) =>
    qs >= 22.0 ? 2 : qs >= 12.0 ? 1 : 0

method deleteVis(zoneObj z) =>
    if not na(z.visBox)
        box.delete(z.visBox)
        z.visBox := na
    if not na(z.topLn)
        line.delete(z.topLn)
        z.topLn := na
    if not na(z.btmLn)
        line.delete(z.btmLn)
        z.btmLn := na
    if not na(z.lvlLbl)
        label.delete(z.lvlLbl)
        z.lvlLbl := na
    true

method retireVis(zoneObj z) =>
    if keepHistory and retiredCountArr.get(0) < maxRetired and (not na(z.visBox) or not na(z.topLn))
        if not na(z.visBox)
            box.set_right(z.visBox, bar_index)
            box.set_extend(z.visBox, extend.none)
        if not na(z.topLn)
            line.set_x2(z.topLn, bar_index)
            line.set_extend(z.topLn, extend.none)
        if not na(z.btmLn)
            line.set_x2(z.btmLn, bar_index)
            line.set_extend(z.btmLn, extend.none)
        if not na(z.lvlLbl)
            label.delete(z.lvlLbl)
        z.visBox := na
        z.topLn  := na
        z.btmLn  := na
        z.lvlLbl := na
        retiredCountArr.set(0, retiredCountArr.get(0) + 1)
    else
        z.deleteVis()
    true

clampZone(float top, float btm, float _atr) =>
    float zTop = top
    float zBtm = btm
    float sz = zTop - zBtm
    float maxSz = _atr * maxZoneSizeATR
    if sz > maxSz
        float diff = sz - maxSz
        zTop -= diff / 2
        zBtm += diff / 2
    [zTop, zBtm]

// BUG-11 fix: rank by full quality score
method dropWeakest(array<zoneObj> arr) =>
    if arr.size() > 0
        int wi = 0
        float ws = 999999.0
        for i = 0 to arr.size() - 1
            zoneObj zt = arr.get(i)
            if zt.qualityScore < ws
                ws := zt.qualityScore
                wi := i
        zoneObj zd = arr.get(wi)
        zd.deleteVis()
        arr.remove(wi)
    true

// BUG-10 fix: compare all zone pairs within price proximity, not index proximity
method combineOverlapping(array<zoneObj> arr, float _atr) =>
    if mergeOverlap and arr.size() > 1
        bool merged = true
        int safetyCounter = 0
        while merged and arr.size() > 1 and safetyCounter < 20
            merged := false
            safetyCounter += 1
            for i = arr.size() - 1 to 1
                if arr.size() < 2
                    break
                zoneObj z1 = arr.get(i)
                for j = i - 1 to 0
                    zoneObj z2 = arr.get(j)
                    if z1.isBull == z2.isBull and math.min(z1.top, z2.top) > math.max(z1.btm, z2.btm)
                        z2.top := math.max(z1.top, z2.top)
                        z2.btm := math.min(z1.btm, z2.btm)
                        [newT, newB] = clampZone(z2.top, z2.btm, _atr)
                        z2.top := newT
                        z2.btm := newB
                        z2.volQuality := math.max(z2.volQuality, z1.volQuality)
                        z2.qualTouches := math.max(z2.qualTouches, z1.qualTouches)
                        z2.htfBonus := math.max(z2.htfBonus, z1.htfBonus)
                        z2.flipped := z2.flipped or z1.flipped
                        z1.deleteVis()
                        arr.remove(i)
                        merged := true
                        break
                if merged
                    break
    true

// ============================================================================================
// ZONE CREATION  (BUG-05, BUG-08, BUG-09, BUG-12, MATH-03/04 fixes applied)
// ============================================================================================
f_addZone(bool doAdd, bool isBullZone, float pivotPx, bool fvgConf, float depStr) =>
    if doAdd
        float zT = pivotPx + bandR
        float zB = pivotPx - bandR
        [cT, cB] = clampZone(zT, zB, atr)
        zT := cT
        zB := cB

        // BUG-09 fix: check for duplicate across the single array
        bool merged = false
        float tolM = atr * mergeAtrFrac
        for z in zones
            if z.isBull == isBullZone and pivotPx >= z.btm - tolM and pivotPx <= z.top + tolM
                z.top := math.max(z.top, zT)
                z.btm := math.min(z.btm, zB)
                [mT, mB] = clampZone(z.top, z.btm, atr)
                z.top := mT
                z.btm := mB
                z.volQuality := math.max(z.volQuality, volState)
                merged := true
                break

        if not merged
            float minSp = atr * dyn_space
            bool tooClose = false
            for ez in zones
                if math.abs(ez.top - zT) < minSp and ez.isBull == isBullZone
                    tooClose := true
                    break

            if not tooClose
                // MATH-03/04 fix: displacement-based filter replaces near-vacuous momentum count
                float pivotBody = impulseR
                float pivotATR = nz(atr[pivR])
                bool hasDisplacement = pivotATR > 0 and pivotBody / pivotATR >= displacementMult * dyn_mom
                bool hasVol = hasVolData and volR > avgVolR * 1.5
                bool strongMove = isBullZone ? bullMomentum >= momentumCount : bearMomentum >= momentumCount

                if strongMove and (hasDisplacement or hasVol)
                    // Count bull/bear zones separately for capacity
                    int sameCount = 0
                    for ez in zones
                        if ez.isBull == isBullZone
                            sameCount += 1
                    if sameCount >= dyn_nPiv
                        // Drop weakest same-polarity zone
                        int wi = -1
                        float ws = 999999.0
                        for i = 0 to zones.size() - 1
                            zoneObj zt = zones.get(i)
                            if zt.isBull == isBullZone and zt.qualityScore < ws
                                ws := zt.qualityScore
                                wi := i
                        if wi >= 0
                            zoneObj zd = zones.get(wi)
                            zd.deleteVis()
                            zones.remove(wi)

                    int hB = f_htfConf(isBullZone, zT, zB, htfTol) ? 2 : 0
                    bool pdwC = f_pdwConf(zT, zB, htfTol)
                    int vQ = volState
                    float disp = pivotATR > 0 ? pivotBody / pivotATR : 0.0

                    nextZoneIdArr.set(0, nextZoneIdArr.get(0) + 1)
                    zoneObj newZ = zoneObj.new(
                         id = nextZoneIdArr.get(0),
                         top = zT, btm = zB, isBull = isBullZone,
                         birthBar = bar_index,   // BUG-05 fix: confirmation time
                         birthTime = time,
                         touches = 0,            // BUG-08/12 fix: starts at 0, not 1
                         qualTouches = 0,
                         lastTouchTime = 0,
                         maxReaction = 0.0,      // BUG-04 fix: no pre-loaded reaction
                         reactionEarned = false,
                         reactionSpeed = 0,
                         displacement = disp,
                         volQuality = vQ,
                         htfBonus = hB,
                         mtfConf = false,
                         pdwConf = pdwC,
                         failedBreaks = 0,
                         flipped = false,
                         flipBar = 0,
                         flipQuality = 0.0,
                         tier = 0,
                         qualityScore = 0.0,
                         lastSigBar = 0,
                         sigCount = 0,
                         status = Z_CREATED,
                         freshness = 100)
                    zones.push(newZ)
        true

// ============================================================================================
// ZONE LIFECYCLE ENGINE  (confirmed bars only)
// ============================================================================================
processZones() =>
    if zones.size() > 0 and insideLookback
        float invH = invalidation == "Close" ? close : high
        float invL = invalidation == "Close" ? close : low

        for i = zones.size() - 1 to 0
            if i >= zones.size()
                continue
            zoneObj z = zones.get(i)
            int age = bar_index - z.birthBar

            // --- Lifecycle: CREATED → QUALIFYING ---
            if z.status == Z_CREATED
                z.status := Z_QUALIFYING

            // --- Lifecycle: QUALIFYING → ACTIVE ---
            if z.status == Z_QUALIFYING and age >= minZoneDuration
                z.status := Z_ACTIVE

            // --- Freshness decay — BUG-06 fix: continuous, affects scoring ---
            z.freshness := math.max(0, 100 - math.round(age * 100.0 / (dyn_decay * 2.0)))

            // --- Touch detection (BUG-12 fix: record state BEFORE scoring) ---
            bool isTouch = false
            if z.status >= Z_ACTIVE
                isTouch := z.isBull ? (low <= z.top and close > z.top and isBullWick) : (high >= z.btm and close < z.btm and isBearWick)
                if isTouch and (time - z.lastTouchTime > curTFMS * 5)
                    z.touches += 1
                    float wickF = candleRange > 0 ? (z.isBull ? lowerWick : upperWick) / candleRange : 0.0
                    if wickF >= sigMinWick
                        z.qualTouches += 1
                    z.lastTouchTime := time
                    z.maxReaction := 0.0           // BUG-04 fix: reset reaction on each touch
                    z.reactionEarned := false
                    z.reactionSpeed := 0
                    if z.status == Z_ACTIVE
                        z.status := Z_RETESTED

            // --- Reaction tracking (BUG-04 fix: post-touch only) ---
            if z.touches > 0 and z.status >= Z_ACTIVE
                if z.isBull
                    if high > z.top + z.maxReaction
                        z.maxReaction := high - z.top
                else
                    if low < z.btm - z.maxReaction
                        z.maxReaction := z.btm - low
                if not z.reactionEarned and not na(atr) and atr > 0 and z.maxReaction > atr * 1.2
                    z.reactionEarned := true
                    z.reactionSpeed := bar_index - z.lastTouchTime

            // --- HTF / MTF / PDW confluence refresh ---
            if z.htfBonus == 0 and f_htfConf(z.isBull, z.top, z.btm, htfTol)
                z.htfBonus := 2
            z.mtfConf := f_mtfOverlap(z.isBull, z.top, z.btm)
            z.pdwConf := f_pdwConf(z.top, z.btm, htfTol)

            // --- Quality score & tier (uses state BEFORE this bar's signal scan) ---
            z.qualityScore := f_calcQualityScore(z, atr)
            int prevTier = z.tier
            z.tier := f_tier(z.qualityScore)

            // --- Degradation ---
            if z.status >= Z_ACTIVE and z.status != Z_FLIPPED and z.tier == 0
                z.status := Z_DEGRADED

            // --- Un-degrade if score recovers ---
            if z.status == Z_DEGRADED and z.tier >= 1
                z.status := Z_ACTIVE

            // --- Expiry ---
            if age > dyn_decay * 2
                if keepHistory and prevTier == 2 and retiredCountArr.get(0) < maxRetired
                    z.retireVis()
                else
                    z.deleteVis()
                z.status := Z_EXPIRED
                zones.remove(i)
                continue

            // --- SMC POLARITY FLIP & BREAKOUT FIX (SMART VALIDATION) ---
            if isBrokenUp or isBrokenDn
                validBreak = isBrokenUp ? ((close > z.top and not isBearWick) and (hasVolumeSurge or z.htfBonus > 0)) : ((close < z.btm and not isBullWick) and (hasVolumeSurge or z.htfBonus > 0))
                
                if validBreak and flipZones
                    if not na(z.visBox)
                        box.set_right(z.visBox, bar_index)
                        box.set_extend(z.visBox, extend.none)
                    if not na(z.topLn)
                        line.set_x2(z.topLn, bar_index)
                        line.set_extend(z.topLn, extend.none)

                    z.isBull := isBrokenUp ? true : false
                    z.birthBar := bar_index
                    z.touches := 1
                    z.volBonus := 0
                    z.htfBonus := 0
                    z.reactionBonus := 0
                    
                    z.visBox := na
                    z.topLn := na
                    z.btmLn := na
                    if not na(z.lvlLbl)
                        label.delete(z.lvlLbl)
                        z.lvlLbl := na
                else
                    // 🟢 HISTORICAL MEMORY LOGIC FIX (Only saves Elite levels)
                    if keepHistory and isElite
                        z.retireVis()
                    else
                        z.deleteVis()
                    array.remove(arr, i)
                    continue

            // 🟢 HARD FILTER BEFORE DRAWING (MASSIVE NOISE REDUCTION)
            if (isElite or isStrong) and age >= minZoneDuration
                c = getZoneColor(isElite, z.isBull) 
                bC = getBorderColor(z.isBull)
                
                if drawMode == "Boxes"
                    if na(z.visBox)
                        z.visBox := box.new(z.birthBar, z.top, bar_index, z.btm, border_color=bC, bgcolor=c, extend=extrap)
                    else
                        box.set_right(z.visBox, bar_index)
                        box.set_bgcolor(z.visBox, c)
                        box.set_border_color(z.visBox, bC)
                        box.set_extend(z.visBox, extrap)
                else
                    mid = (z.top + z.btm) / 2
                    if na(z.topLn)
                        z.topLn := line.new(z.birthBar, mid, bar_index, mid, color=bC, width=2, extend=extrap)
                    else
                        line.set_x2(z.topLn, bar_index)
                        line.set_color(z.topLn, bC)
                        line.set_extend(z.topLn, extrap)

                if lLab
                    string priceTxt = str.tostring(z.top, format.mintick) + " - " + str.tostring(z.btm, format.mintick)
                    float midY = (z.top + z.btm) / 2
                    if na(z.lvlLbl)
                        z.lvlLbl := label.new(bar_index + 3, midY, priceTxt, color=color.new(bC, 20), textcolor=textColor, style=label.style_label_left, size=size.small)
                    else
                        label.set_xy(z.lvlLbl, bar_index + 3, midY)
                        label.set_text(z.lvlLbl, priceTxt)
                        label.set_color(z.lvlLbl, color.new(bC, 20))
                else
                    if not na(z.lvlLbl)
                        label.delete(z.lvlLbl)
                        z.lvlLbl := na
    true // Fixes compilation "Mismatched return type" errors

// Execute unconditionally (Lookback is handled natively inside function)
processZoneArray(highZones)
processZoneArray(lowZones)

// ================================== //
// ----> S&D MTF Engine <--- //
// ================================== //
if display30m and str.tonumber(currentTimeframe) <= 30
    createSupplyDemandZones('30')
if display1h and str.tonumber(currentTimeframe) <= 60
    createSupplyDemandZones('60') 
if display4h and str.tonumber(currentTimeframe) <= 240
    createSupplyDemandZones('240')
if displayD and str.tonumber(currentTimeframe) <= 1440
    createSupplyDemandZones('D')
if displayW and str.tonumber(currentTimeframe) <= 10080
    createSupplyDemandZones('W')

mergeMTFBoxes(supply_HT)
mergeMTFBoxes(demand_HT)

int i_s = 0
while i_s < array.size(supply_HT) 
    mtfZone currentZone = array.get(supply_HT, i_s)
    box currentBox = currentZone.b
    if high > box.get_top(currentBox) 
        array.remove(supply_HT, i_s)
        box.delete(currentBox)
    else
        box.set_right(currentBox, momentCTD)
        i_s += 1

int i_d = 0
while i_d < array.size(demand_HT) 
    mtfZone currentZone = array.get(demand_HT, i_d)
    box currentBox = currentZone.b
    if low < box.get_bottom(currentBox) 
        array.remove(demand_HT, i_d)
        box.delete(currentBox)
    else
        box.set_right(currentBox, momentCTD)
        i_d += 1


// ================================== //
// ------> Conditional Displays <---- //
// ================================== //

// Add Previous Day / Week Levels 
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_on)

var line pdh_line = na
var line pdl_line = na
var label pdh_lbl = na
var label pdl_lbl = na

var line pwh_line = na
var line pwl_line = na
var label pwh_lbl = na
var label pwl_lbl = na

var int line_start_gap = 20
var int text_pos_gap = 40

if barstate.islast
    // Daily
    pdh_text = "PDH : " + str.tostring(pdh, format.mintick)
    pdl_text = "PDL : " + str.tostring(pdl, format.mintick)
    if na(pdh_line)
        pdh_line := line.new(bar_index + line_start_gap, pdh, bar_index + line_start_gap + 1, pdh, color=color.gray, style=line.style_dashed, width=1, extend=extend.right)
        pdl_line := line.new(bar_index + line_start_gap, pdl, bar_index + line_start_gap + 1, pdl, color=color.gray, style=line.style_dashed, width=1, extend=extend.right)
        pdh_lbl  := label.new(bar_index + text_pos_gap, pdh, pdh_text, style=label.style_none, textcolor=color.gray, size=size.small)
        pdl_lbl  := label.new(bar_index + text_pos_gap, pdl, pdl_text, style=label.style_none, textcolor=color.gray, size=size.small)
    else
        line.set_xy1(pdh_line, bar_index + line_start_gap, pdh)
        line.set_xy2(pdh_line, bar_index + line_start_gap + 1, pdh)
        line.set_xy1(pdl_line, bar_index + line_start_gap, pdl)
        line.set_xy2(pdl_line, bar_index + line_start_gap + 1, pdl)
        label.set_xy(pdh_lbl, bar_index + text_pos_gap, pdh)
        label.set_text(pdh_lbl, pdh_text)
        label.set_xy(pdl_lbl, bar_index + text_pos_gap, pdl)
        label.set_text(pdl_lbl, pdl_text)

    // Weekly
    pwh_text = "PWH : " + str.tostring(pwh, format.mintick)
    pwl_text = "PWL : " + str.tostring(pwl, format.mintick)
    if na(pwh_line)
        pwh_line := line.new(bar_index + line_start_gap, pwh, bar_index + line_start_gap + 1, pwh, color=color.new(color.white, 40), style=line.style_dotted, width=2, extend=extend.right)
        pwl_line := line.new(bar_index + line_start_gap, pwl, bar_index + line_start_gap + 1, pwl, color=color.new(color.white, 40), style=line.style_dotted, width=2, extend=extend.right)
        pwh_lbl  := label.new(bar_index + text_pos_gap, pwh, pwh_text, style=label.style_none, textcolor=color.new(color.white, 40), size=size.small)
        pwl_lbl  := label.new(bar_index + text_pos_gap, pwl, pwl_text, style=label.style_none, textcolor=color.new(color.white, 40), size=size.small)
    else
        line.set_xy1(pwh_line, bar_index + line_start_gap, pwh)
        line.set_xy2(pwh_line, bar_index + line_start_gap + 1, pwh)
        line.set_xy1(pwl_line, bar_index + line_start_gap, pwl)
        line.set_xy2(pwl_line, bar_index + line_start_gap + 1, pwl)
        label.set_xy(pwh_lbl, bar_index + text_pos_gap, pwh)
        label.set_text(pwh_lbl, pwh_text)
        label.set_xy(pwl_lbl, bar_index + text_pos_gap, pwl)
        label.set_text(pwl_lbl, pwl_text)
