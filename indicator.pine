//@version=6
// =============================================================================================
//  ARPAN'S S&R + SIGNAL ENGINE   (shorttitle: ASR Engine v2 )
// ---------------------------------------------------------------------------------------------
//
//  NEW ENGINES:  structure (BOS / swing state), liquidity (sweep / reclaim),
//                regime (trend × volatility), 5 setup types.
//  SCORING:  Zone Quality (0–35) + Setup Quality (0–35) + Context (0–30) = 0–100.
//  TRADE ACCOUNTING:  WIN / LOSS / BREAKEVEN / TIME_EXIT reported separately.
//
//  NON-REPAINTING:  all HTF requests use [1] offset + lookahead_on.
//  CONFIRMED BARS ONLY:  all state mutations gated by barstate.isconfirmed.
//
//  ALERT SETUP:  Create Alert → Condition "ASR Engine v2" → "Any alert() function call"
//                → Webhook URL (HTTPS, port 443).  Requires TradingView Essential+.
//
//  Not financial advice.  No profitability is promised.
// =============================================================================================
indicator("Arpan's S&R + Signal Engine v2", shorttitle = "ASRv3", overlay = true,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500, max_bars_back = 5000)

// ============================================================================================
// INPUTS
// ============================================================================================
G_CORE  = "1 | Core Engine"
G_INST  = "2 | Zone Quality Engine"
G_PIV   = "3 | Pivot Zones S&R"
G_SD    = "4 | Supply & Demand (MTF)"
G_SDV   = "5 | S&D Aesthetics"
G_VOL   = "6 | Volume Filter"
G_SIG   = "7 | Signal Engine"
G_RISK  = "8 | Risk Model & Costs"
G_STRUCT = "9 | Market Structure"
G_LIQ   = "10 | Liquidity Engine"
G_REG   = "11 | Regime Engine"
G_ALR   = "12 | Alerts / Webhook"
G_UI    = "13 | Dashboard & Visuals"

// --- 1 | CORE ENGINE ---
maxBarsBack  = input.int(3000, "Lookback Limit (bars)", minval = 200, group = G_CORE, tooltip = "Performance gate only. The canonical Python engine processes all bars.")
drawMode     = input.string("Boxes", "Draw Mode", options = ["Boxes", "Lines"], group = G_CORE)
invalidation = input.string("Close", "Zone Invalidation", options = ["Close", "Wick"], group = G_CORE)
useMTF       = input.bool(true, "Use HTF Swing Confluence", group = G_CORE)
htfRes       = input.timeframe("240", "Higher Timeframe", group = G_CORE)
htfPivLen    = input.int(5, "HTF Swing Length", minval = 2, maxval = 20, group = G_CORE)
htfTolATR    = input.float(0.35, "HTF Overlap Tolerance (ATR)", minval = 0.0, step = 0.05, group = G_CORE)
useAutoAsset = input.bool(true, "Auto-Tune Asset Matrix", group = G_CORE)
assetOverride = input.string("Auto", "Asset Override", options = ["Auto", "CRYPTO", "GOLD", "SILVER", "FOREX", "INDEX", "ENERGY", "MACRO", "OTHER"], group = G_CORE, tooltip = "Force asset class instead of auto-detection.")
marketOverride = input.string("Auto", "Market Type Override", options = ["Auto", "SPOT", "PERPETUAL", "FUTURES", "FOREX", "CFD", "OTHER"], group = G_CORE, tooltip = "Force market type. SPOT disables shorts.")

// --- 2 | ZONE QUALITY ENGINE ---
momentumBodyMult = input.float(0.5, "Momentum Body Mult", minval = 0.1, step = 0.05, group = G_INST, tooltip = "Ignored when Auto-Tune is on.")
momentumCount    = input.int(2, "Momentum Count", minval = 1, group = G_INST)
maxZoneSizeATR   = input.float(1.8, "Max Zone Size (ATR)", minval = 0.3, step = 0.1, group = G_INST)
mergeOverlap     = input.bool(true, "Merge Overlapping Zones", group = G_INST)
minZoneDuration  = input.int(3, "Min Zone Age From Confirm (Bars)", minval = 0, group = G_INST, tooltip = "BUG-05 fix: age measured from confirmation, not pivot.")
mergeAtrFrac     = input.float(0.3, "Zone Merge Dist (ATR)", minval = 0.0, step = 0.05, group = G_INST)
decayFactor      = input.int(800, "Decay Factor (Bars)", minval = 50, group = G_INST, tooltip = "Ignored when Auto-Tune is on.")
displacementMult = input.float(1.5, "Displacement Body (ATR mult)", minval = 0.5, step = 0.1, group = G_INST, tooltip = "BUG/MATH-03 fix: replaces near-vacuous momentum filter. Bar body must exceed this × ATR.")

// --- 3 | PIVOT ZONES ---
pivL        = input.int(12, "Look Left", minval = 1, group = G_PIV)
pivR        = input.int(12, "Look Right", minval = 1, maxval = 50, group = G_PIV)
nPiv        = input.int(10, "Max Pivot Memory", minval = 2, maxval = 40, group = G_PIV)
atrLen      = input.int(20, "ATR Length", minval = 1, group = G_PIV)
zoneMult    = input.float(0.5, "Zone Width (ATR)", minval = 0.05, step = 0.05, group = G_PIV)
maxPct      = input.float(4.0, "Max Zone Percent", minval = 0.1, step = 0.1, group = G_PIV)
extendR     = input.bool(false, "Extend Right", group = G_PIV)
lLab        = input.bool(false, "Show Level Labels", group = G_PIV)
flipZones   = input.bool(true, "Flip Zones on Break (Polarity)", group = G_PIV)
keepHistory = input.bool(true, "Show Elite Broken Zones", group = G_PIV)
dhighs      = input.bool(true, "Detect Pivot Highs", group = G_PIV)
dlows       = input.bool(true, "Detect Pivot Lows", group = G_PIV)
